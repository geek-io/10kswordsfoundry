    {
      "_id": "7f0555476a902f9b",
      "name": "Ghost",
      "type": "trait",
      "img": "systems/10kswordsfoundry/assets/icons/trait.svg",
      "folder": "df38e71c0e7b020d",
      "system": {
        "description": "<p>An informational echo given flesh by Esoteric Fluctuation. Is endlessly hungry and lost. A spirit. Can dissipate and take on a Subtle Body. Always has a craving that tethers their information to the present world.</p><p>World Being Trait. Conditional effects are disabled until their condition applies. Action-count changes, immunities, triggered healing and narrative abilities remain manual.</p>",
        "source": "Rules 2.0.3, p.213",
        "tags": "World Being, Trait, 3d6 6",
        "level": 1,
        "active": true
      },
      "effects": []
