<section class="sheet-body">
<header class="character-header">
  <div class="character-logo"><img src="systems/10kswordsfoundry/assets/character-logo.png" alt="1 Sword Against Heaven"></div>
  <div class="character-heading">
    <button class="portrait-picker" type="button" data-action="choosePortrait" aria-label="Choose character portrait" title="Choose character portrait" {{#unless editable}}disabled{{/unless}}>
      <img class="character-portrait" src="{{actor.img}}" alt="Portrait of {{actor.name}}">
    </button>
    <label class="character-name">Name <input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}></label>
  </div>
</header><nav class="swords-nav" aria-label="Character sections"><button type="button" data-action="sheetPanel" data-panel="overview">Overview</button><button type="button" data-action="sheetPanel" data-panel="combat">Combat</button><button type="button" data-action="sheetPanel" data-panel="inventory">Inventory</button><button type="button" data-action="sheetPanel" data-panel="identity">Identity</button><button type="button" data-action="sheetPanel" data-panel="notes">Notes</button><button type="button" data-action="sheetPanel" data-panel="effects">Effects</button></nav>
{{#if canLinkWanderer}}<section><button type="button" data-action="linkWanderer">Sync with sidebar</button></section>{{/if}}
<fieldset class="job-drop-zone" data-drop-zone="job"><legend>Job</legend>
{{#if jobItem}}<div class="job-entry" data-item-id="{{jobItem.id}}" data-rarity="{{jobItem.system.rarity}}"><strong>{{jobItem.name}}</strong><button type="button" data-action="editItem" data-item-id="{{jobItem.id}}">Edit</button></div>{{else}}<p>Drop a Job here</p>{{/if}}
</fieldset><section><h2>Gear Slots</h2><div class="grid">{{#each gearSlots}}<span><strong>{{label}}</strong>: {{names}}</span>{{/each}}</div>{{#if unassignedWeapons}}<p class="capacity-warning">Assign a free hand or unequip: {{unassignedWeapons}}</p>{{/if}}{{#if system.carryOverage}}<p class="capacity-warning">Over Carry capacity by {{system.carryOverage}}. Remove or ready carried items to free space.</p>{{/if}}</section><fieldset {{#unless editable}}disabled{{/unless}}><legend>Identity</legend><div class="grid"><label>Culture<input name="system.culture" value="{{system.culture}}"></label><label>Truth<input name="system.truth" value="{{system.truth}}"></label><label>Alignment<input name="system.alignment" value="{{system.alignment}}"></label></div></fieldset><fieldset {{#unless editable}}disabled{{/unless}}><legend>Checks &amp; Cultivations</legend><div class="check-toolbar"><button type="button" data-action="rest">Rest</button><span>AP: {{#each apSymbols}}<span class="resource-symbol {{#unless available}}spent{{/unless}}" title="{{#if available}}Available{{else}}Spent{{/if}} AP">✦</span>{{/each}}</span></div>{{#if samadhiActive}}<p><strong>Samadhi: +3 to checks</strong> <button type="button" data-action="endSamadhi">End Samadhi</button></p>{{/if}}<div class="grid">
{{#each cultivations}}<div class="cultivation-card" data-tooltip="{{tooltip}}" data-tooltip-class="swords-cultivation-tooltip"><button type="button" class="cultivation-symbol" data-action="check" data-cultivation="{{key}}" aria-label="Roll {{label}}"><img src="{{icon}}" alt="{{name}} symbol"><span>{{label}}</span></button><input aria-label="{{label}} rating" type="number" min="0" step="1" name="system.cultivations.{{key}}" value="{{value}}"></div>{{/each}}
</div></fieldset><fieldset {{#unless editable}}disabled{{/unless}}><legend>Movement</legend><div class="grid"><label>Movement (m)<input name="system.movement" value="{{system.movement}}" type="number" min="0" step="1"></label></div></fieldset>{{#if effectiveSummary}}<p>Fields show base values. With active effects: {{effectiveSummary}}</p>{{/if}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>AP & Ardor</legend><div class="grid"><label>Maximum Ardor<input name="system.ardor.max" value="{{system.ardor.max}}" type="number" min="{{ardorMinimumMax}}" step="1"></label><label>Burnt Ardor<input name="system.ardor.burnt" value="{{system.ardor.burnt}}" type="number" min="0" step="1" max="{{ardorBurntLimit}}"></label><label>Installed Ardor<input name="system.ardor.installed" value="{{system.ardor.installed}}" type="number" min="0" step="1" max="{{ardorInstalledLimit}}"></label></div></fieldset><div class="ardor-track">{{#each ardorSymbols}}<span class="resource-symbol {{state}}" title="{{label}}">{{symbol}}</span>{{/each}}<small>✹ Available · dim ✹ Burnt · ❂ Installed</small></div><p>AP: {{#each apSymbols}}<span class="resource-symbol {{#unless available}}spent{{/unless}}" title="Action Point">✦</span>{{/each}}</p><div class="round-controls"><button type="button" data-action="refreshActions" {{#unless editable}}disabled{{/unless}}>New Round</button></div><fieldset {{#unless editable}}disabled{{/unless}}><legend>Health Sutra</legend><div class="health-sutra">{{#each sutra.boxes}}<button type="button" class="health-box health-{{tone}} {{#if selected}}selected{{/if}}" data-action="setHealth" data-health-value="{{value}}" aria-pressed="{{selected}}" title="Set Health to {{value}}">{{#if selected}}☒{{else}}☐{{/if}} {{label}} ({{penalty}})</button>{{/each}}<button type="button" class="health-box health-ko {{#if sutra.knockedOut}}selected{{/if}}" data-action="setHealth" data-health-value="0" aria-pressed="{{sutra.knockedOut}}">{{#if sutra.knockedOut}}☒{{else}}☐{{/if}} Knocked Out</button></div><p>{{sutra.value}} / {{sutra.max}} Health · {{sutra.status}}{{#unless sutra.knockedOut}} ({{sutra.penalty}} to checks){{/unless}}</p><div class="armor-sutra"><strong>Armor · {{armorTrack.value}} / {{armorTrack.max}}</strong><div class="armor-boxes"><button type="button" data-action="setArmor" data-armor-value="0" title="Set Armor to zero">0</button>{{#each armorTrack.boxes}}<button type="button" class="armor-box {{#if filled}}filled{{/if}}" data-action="setArmor" data-armor-value="{{value}}" aria-label="Set Armor to {{value}}" aria-pressed="{{filled}}">{{#if filled}}◆{{else}}◇{{/if}}</button>{{else}}<span>No Armor equipped</span>{{/each}}</div></div></fieldset><fieldset {{#unless editable}}disabled{{/unless}}><legend>Conditions &amp; Actions</legend><p>{{#if system.conditions.blaze}}<button type="button" data-action="resolveOngoing" data-condition="blaze">Blaze: resolve a round outside combat</button>{{/if}} {{#if system.conditions.toxic}}<button type="button" data-action="resolveOngoing" data-condition="toxic">Toxic: 10-minute SPI check</button>{{/if}}</p><div class="condition-grid">{{#each conditionRows}}<label class="condition-entry"><span><input type="checkbox" name="system.conditions.{{key}}" {{checked active}}> {{label}}</span><small>{{description}}</small></label>{{/each}}</div><div class="action-controls"><button type="button" data-action="spendAction">Spend Action</button><button type="button" data-action="interrupt">Interrupt</button></div><p>Bloodied Samadhi: {{#if system.bloodiedSamadhiUsed}}used this Rest{{else}}available{{/if}}</p></fieldset><fieldset {{#unless editable}}disabled{{/unless}}><legend>Cultivation & Travel</legend><div class="grid"><label>Sidhi Stage<input name="system.sidhi" value="{{system.sidhi}}" type="number" min="0" step="1"></label><label>Open Meridians<input name="system.meridians" value="{{system.meridians}}" type="number" min="0" step="1"></label><label>Carry remaining<input name="system.carry" value="{{system.carry}}" type="number" min="0" step="1"></label><label>XP<input name="system.xp" value="{{system.xp}}" type="number" min="0" step="1"></label><label>Foundation<input name="system.foundation" value="{{system.foundation}}" type="number" min="0" step="1"></label><label>Magnetite (Mag)<input name="system.mag" value="{{system.mag}}" type="number" min="0" step="1"></label></div></fieldset><section><h2>Special Abilities</h2><ul class="inventory">{{#each specialAttackRows}}<li data-item-id="{{itemId}}"><span><strong>{{name}}</strong><small>{{itemName}} · {{apCost}} ✦ · Burn {{burnArdor}} ✹ · Install {{installArdor}} ❂</small></span><button type="button" data-action="useAbility" data-item-id="{{itemId}}" data-special-index="{{index}}" {{#unless ../editable}}disabled{{/unless}}>{{actionLabel}}</button></li>{{else}}<li>Configure Special Abilities on a Weapon, Fashion, or Technick, then equip it.</li>{{/each}}</ul></section><section><h2>Traits</h2><button type="button" data-action="addNew" data-item-type="trait">Add New</button><button type="button" data-action="autoSort" data-item-type="trait">Auto-sort</button><ul class="inventory">{{#each traitItems}}<li data-item-id="{{id}}"><span>{{name}} · Level {{system.level}}{{#if effects}}<details class="trait-effects"><summary>Situational effects</summary>{{#each effects}}<label><button type="button" data-action="toggleTraitEffect" data-item-id="{{../id}}" data-effect-id="{{id}}">{{#if disabled}}Enable{{else}}Disable{{/if}}</button> {{name}}</label>{{/each}}</details>{{/if}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="toggleTrait" data-item-id="{{id}}">{{#if traitEnabled}}Deactivate{{else}}Activate{{/if}}</button></li>{{else}}<li>No Traits yet.</li>{{/each}}</ul></section>{{#if isWorldBeing}}<section><h2>Gambits</h2><button type="button" data-action="addNew" data-item-type="gambit">Add New</button><button type="button" data-action="autoSort" data-item-type="gambit">Auto-sort</button><ul class="inventory">{{#each gambitItems}}<li data-item-id="{{id}}"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button></li>{{/each}}</ul></section>{{/if}}<section><h2>Readied Combat Items</h2><button type="button" data-action="defense" {{#unless editable}}disabled{{/unless}}>Defense</button><ul class="inventory">{{#each combatItems}}<li data-item-id="{{id}}" data-rarity="{{system.rarity}}"><span><strong>{{name}}</strong>{{#if isAbility}}<small class="ability-costs">AP {{system.apCost}} ✦ · Burn {{system.burnArdor}} ✹ · Install {{system.installArdor}} ❂</small>{{/if}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button>{{#if canAttack}}<button type="button" data-action="attack" data-item-id="{{id}}">Attack</button>{{/if}}{{#if isAbility}}{{#if configuredActions}}{{#if internalized}}<button type="button" data-action="toggleEquipment" data-item-id="{{id}}">Release</button>{{else}}<small>Use Special Abilities in Combat</small>{{/if}}{{else}}<button type="button" data-action="{{#if internalized}}toggleEquipment{{else}}useAbility{{/if}}" data-item-id="{{id}}">{{#if internalized}}Release{{else}}{{actionLabel}}{{/if}}</button>{{/if}}{{/if}}</li>{{else}}<li>Equip weapons or add Magicks and Technicks from Inventory.</li>{{/each}}</ul></section><section><h2>Licenses</h2><button type="button" data-action="addNew" data-item-type="license">Add New</button><button type="button" data-action="autoSort" data-item-type="license">Auto-sort</button>{{#if system.meridianOverage}}<p class="capacity-warning">Licenses exceed Meridian capacity by {{system.meridianOverage}}. Unslot Licenses to resolve this.</p>{{/if}}<ul class="inventory license-list">
{{#each licenses}}<li data-rarity="{{system.rarity}}" class="license-entry {{#unless qualified}}unqualified{{/unless}}" data-item-id="{{id}}"><span><strong>{{name}}</strong><small>{{sect}} · {{status}}</small></span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="toggleLicense" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>{{#if equipped}}Unequip{{else}}Equip{{/if}}</button></li>{{else}}<li>Drop a License onto the sheet</li>{{/each}}
</ul></section><section><h2>Fashion</h2><button type="button" data-action="addNew" data-item-type="fashion">Add New</button><button type="button" data-action="autoSort" data-item-type="fashion">Auto-sort</button><ul class="inventory">
{{#each fashions}}<li data-item-id="{{id}}" data-rarity="{{system.rarity}}"><span><strong>{{name}}</strong> · Armor +{{system.armor}} · Ardor +{{system.ardor}} · {{#if system.equipped}}Equipped{{else}}Unequipped{{/if}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="toggleEquipment" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>{{#if system.equipped}}Unequip{{else}}Equip{{/if}}</button><button type="button" data-action="removeEquipment" data-item-id="{{id}}" {{#unless ../editable}}disabled{{/unless}}>Remove</button></li>{{else}}<li>No Fashion yet.</li>{{/each}}
</ul></section>{{#each abilityGroups}}<section><h2>{{label}}</h2><button type="button" data-action="addNew" data-item-type="{{type}}">Add New</button><button type="button" data-action="autoSort" data-item-type="{{type}}">Auto-sort</button><ul class="inventory">{{#each items}}<li data-item-id="{{id}}" data-rarity="{{system.rarity}}"><span><strong>{{name}}</strong><small class="ability-costs">AP {{system.apCost}} ✦ · Burn {{system.burnArdor}} ✹ · Install {{system.installArdor}} ❂</small></span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button>{{#if configuredActions}}{{#if internalized}}<button type="button" data-action="toggleEquipment" data-item-id="{{id}}">Release</button>{{else}}<small>Use Special Abilities in Combat</small>{{/if}}{{else}}<button type="button" data-action="{{#if internalized}}toggleEquipment{{else}}useAbility{{/if}}" data-item-id="{{id}}">{{#if internalized}}Release{{else}}{{actionLabel}}{{/if}}</button>{{/if}}<button type="button" data-action="removeEquipment" data-item-id="{{id}}" {{#unless ../../editable}}disabled{{/unless}}>Remove</button></li>{{else}}<li>No abilities yet.</li>{{/each}}</ul></section>{{/each}}<section><h2>Salvage</h2><button type="button" data-action="addNew" data-item-type="salvage">Add New</button><button type="button" data-action="autoSort" data-item-type="salvage">Auto-sort</button><ul class="inventory">{{#each salvageItems}}<li data-item-id="{{id}}"><span>{{name}} × {{system.quantity}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="removeEquipment" data-item-id="{{id}}">Remove</button></li>{{/each}}</ul></section>{{#each inventoryGroups}}<section><h2>{{label}}</h2><div class="section-tools"><button type="button" data-action="addNew" data-item-type="{{type}}">Add New</button><button type="button" data-action="autoSort" data-item-type="{{type}}">Auto-sort</button></div><ul class="inventory">{{#each items}}<li data-item-id="{{id}}" data-rarity="{{system.rarity}}"><span>{{name}} {{#if system.quantity}}× {{system.quantity}}{{/if}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button>{{#if canConsume}}<button type="button" data-action="useConsumable" data-item-id="{{id}}">Use</button>{{/if}}{{#if equippable}}<button type="button" data-action="toggleEquipment" data-item-id="{{id}}">{{#if system.equipped}}Unequip{{else}}Equip{{/if}}</button>{{/if}}<button type="button" data-action="removeEquipment" data-item-id="{{id}}">Remove</button></li>{{else}}<li>No items yet.</li>{{/each}}</ul></section>{{/each}}<section><h2>Notes</h2>{{#if editable}}<prose-mirror name="system.notes" value="{{notesEditor}}" data-document-uuid="{{actor.uuid}}">{{{notesHTML}}}</prose-mirror>{{else}}<div class="rich-content">{{{notesHTML}}}</div>{{/if}}</section><section><h2>Active Effects</h2>{{#if editable}}<button type="button" data-action="createEffect">Add Effect</button>{{/if}}<ul class="inventory">{{#each effects}}<li><span>{{name}} · {{status}}<small class="effect-source">Source: {{source}}</small>{{#if changes}}<small class="effect-changes">{{changes}}</small>{{/if}}{{#if suppressed}}<small class="effect-source">Activate or equip the source item to apply this effect.</small>{{/if}}</span><button type="button" data-action="editEffect" data-effect-id="{{id}}" data-effect-item-id="{{itemId}}">Edit</button>{{#if ../editable}}<button type="button" data-action="toggleEffect" data-effect-id="{{id}}" data-effect-item-id="{{itemId}}">{{#if disabled}}Enable{{else}}Disable{{/if}}</button><button type="button" data-action="removeEffect" data-effect-id="{{id}}" data-effect-item-id="{{itemId}}">Remove</button>{{/if}}</li>{{/each}}</ul></section></section>