<section class="sheet-body"><header data-rarity="{{system.rarity}}"><h2>{{#if isGambit}}World Being Gambit{{else if isAmmo}}Ammo{{else if isWeaponMod}}Weapon Mod{{else if isWeapon}}Weapon{{else if isMagick}}Magick{{else if isAbility}}Technick{{else if isJob}}Job{{else if isLicense}}License{{else if isFashion}}Fashion{{else}}Gear &amp; Abilities{{/if}}</h2><label>Name<input name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}></label></header><nav class="swords-nav" aria-label="Item sections"><button type="button" data-action="sheetPanel" data-panel="overview">Details</button>{{#if isWeapon}}<button type="button" data-action="sheetPanel" data-panel="combat">Weapon</button>{{else if hasSpecialAttacks}}<button type="button" data-action="sheetPanel" data-panel="combat">Special Abilities</button>{{/if}}<button type="button" data-action="sheetPanel" data-panel="notes">Description</button><button type="button" data-action="sheetPanel" data-panel="effects">Effects</button></nav>{{#if showRarity}}<label>Rarity<select name="system.rarity" {{#unless editable}}disabled{{/unless}}>{{selectOptions rarityChoices selected=system.rarity}}</select></label>{{/if}}{{#if isWeaponMod}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Modifier rule</legend><select name="system.rule">{{selectOptions modifierChoices selected=system.rule}}</select></fieldset>{{/if}}{{#unless isWeaponMod}}{{#if isJob}}<section><h2>Starting Items &amp; Traits</h2><p>This loadout belongs only to {{item.name}}. Changing Jobs replaces its granted items; manually added items stay.</p>{{#each jobGrantGroups}}<fieldset data-job-grants data-grant-type="{{type}}"><legend>{{label}}</legend><ul class="inventory">{{#each items}}<li data-tooltip="{{tooltip}}"><span>{{name}}</span><button type="button" data-action="removeGrant" data-grant-id="{{id}}">Remove</button></li>{{else}}<li>Drop an item here</li>{{/each}}</ul></fieldset>{{/each}}</section><fieldset {{#unless editable}}disabled{{/unless}}><legend>Job</legend><label>Category<select name="system.category">{{selectOptions jobCategories selected=system.category}}</select></label><div class="grid">{{#each cultivations}}<label>{{label}}<input name="system.cultivations.{{key}}" type="number" min="0" step="1" value="{{value}}"></label>{{/each}}</div></fieldset>{{else}}{{#if isLicense}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Sect &amp; Rank</legend><label>Sect<input name="system.sect" value="{{system.sect}}" placeholder="Dracotine, Leonine, Mammon, or homebrew"></label><label>Rank<select name="system.rank">{{selectOptions rankChoices selected=system.rank}}</select></label></fieldset><fieldset {{#unless editable}}disabled{{/unless}}><legend>Prerequisites</legend><div class="grid">{{#each prerequisites}}<label>{{label}}<input name="system.prerequisites.{{key}}" type="number" min="0" step="1" value="{{value}}"></label>{{/each}}<label>Sidhi Stage<input name="system.prerequisites.sidhi" type="number" min="0" step="1" value="{{system.prerequisites.sidhi}}"></label></div></fieldset>{{else}}{{#if isFashion}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Fashion</legend><div class="grid"><label>Armor increase<input name="system.armor" value="{{system.armor}}" type="number" min="0" step="1"></label><label>Ardor increase<input name="system.ardor" value="{{system.ardor}}" type="number" min="0" step="1"></label><label>Magnetite (Mag) cost<input name="system.magCost" value="{{system.magCost}}" type="number" min="0" step="1"></label></div></fieldset>{{else}}{{#if isAmmo}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Ammo stack</legend><div class="grid"><label>Quantity<input name="system.quantity" value="{{system.quantity}}" type="number" min="0" step="1"></label><label>Rules reference<input name="system.source" value="{{system.source}}"></label></div></fieldset>{{else}}{{#if isTrait}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Trait</legend><div class="grid"><label>Level<input name="system.level" value="{{system.level}}" type="number" min="0" step="1"></label><label>Rules reference<input name="system.source" value="{{system.source}}"></label></div></fieldset>{{else if isGambit}}<fieldset><legend>World Being Gambit</legend><label>AP cost (✦)<input name="system.apCost" type="number" min="0" value="{{system.apCost}}"></label><label>Tags<input name="system.tags" value="{{system.tags}}"></label><label>Rules reference<input name="system.source" value="{{system.source}}"></label></fieldset>{{else if isAbility}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Ability details</legend><div class="grid"><label>Bonus<input name="system.bonus" value="{{system.bonus}}" type="number" min="0" step="1"></label><label>Rules reference<input name="system.source" value="{{system.source}}"></label></div></fieldset>{{else}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>{{#if isWeapon}}Weapon stats{{else}}Item stats{{/if}}</legend><div class="grid"><label>Quantity<input name="system.quantity" value="{{system.quantity}}" type="number" min="0" step="1"></label><label>Carry slots each<input name="system.slots" value="{{system.slots}}" type="number" min="0" step="1"></label><label>{{#if isWeapon}}Base attack bonus{{else}}Bonus{{/if}}<input name="system.bonus" value="{{system.bonus}}" type="number" min="0" step="1"></label><label>Tags<input name="system.tags" value="{{system.tags}}"></label><label>Rules reference<input name="system.source" value="{{system.source}}"></label></div></fieldset>{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{#if showGearSlot}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Gear Slot</legend><select name="system.gearSlot">{{selectOptions gearSlotChoices selected=system.gearSlot}}</select></fieldset>{{/if}}{{#if isAmmo}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Ammo type</legend><select name="system.ammoType">{{selectOptions ammoChoices selected=system.ammoType}}</select><p>Each nonempty ammo type uses one Carry slot; matching stacks share it.</p></fieldset>{{/if}}{{#if isAbility}}<fieldset><legend>Library metadata</legend><label>Sect<input name="system.sect" value="{{system.sect}}"></label><label>Sidhi Stage<input name="system.sidhi" type="number" min="0" max="6" value="{{system.sidhi}}"></label></fieldset><fieldset {{#unless editable}}disabled{{/unless}}><legend>Ability costs</legend><div class="grid"><label>AP cost (✦)<input name="system.apCost" type="number" min="0" step="1" value="{{system.apCost}}"></label><label>Burn Ardor (✹)<input name="system.burnArdor" type="number" min="0" step="1" value="{{system.burnArdor}}"></label><label>Install Ardor (❂)<input name="system.installArdor" type="number" min="0" step="1" value="{{system.installArdor}}"></label></div></fieldset>{{/if}}<!-- Magick configuration -->{{#if isMagick}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Magick</legend><div class="grid"><label>Damage type<select name="system.damageType">{{selectOptions damageChoices selected=system.damageType}}</select></label><label>Attacking pool<select name="system.attackPool">{{selectOptions poolChoices selected=system.attackPool}}</select></label><label>Defending pool<select name="system.defensePool">{{selectOptions poolChoices selected=system.defensePool}}</select></label><label>Mantra<input name="system.mantra" value="{{system.mantra}}"></label><label>Mudra<input name="system.mudra" value="{{system.mudra}}"></label><label>Hands required<input name="system.mudraHands" type="number" min="1" max="2" value="{{system.mudraHands}}"></label><label>Area shape<select name="system.areaShape">{{selectOptions areaChoices selected=system.areaShape}}</select></label><label>Area size (m)<input name="system.areaSize" type="number" min="0" value="{{system.areaSize}}"></label></div></fieldset>{{/if}}{{#if isMagick}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Optional enhancement</legend><label>Prompt / effect (blank disables prompt)<textarea name="system.enhancement.description">{{system.enhancement.description}}</textarea></label><div class="grid"><label>Extra AP<input type="number" name="system.enhancement.apCost" value="{{system.enhancement.apCost}}" step="1" min="0"></label><label>Extra burnt Ardor<input type="number" name="system.enhancement.burnArdor" value="{{system.enhancement.burnArdor}}" step="1" min="0"></label><label>Extra installed Ardor<input type="number" name="system.enhancement.installArdor" value="{{system.enhancement.installArdor}}" step="1" min="0"></label><label>Extra dice<input type="number" name="system.enhancement.bonus" value="{{system.enhancement.bonus}}" step="1"></label><label>Extra area size (m)<input type="number" name="system.enhancement.areaBonus" value="{{system.enhancement.areaBonus}}" step="1" min="0"></label><label>Extra Wounds per uncancelled Strike<input type="number" name="system.enhancement.extraWounds" value="{{system.enhancement.extraWounds}}" step="1" min="0"></label></div></fieldset>{{/if}}{{#if isConsumableGear}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Consumable recovery</legend><label><input type="checkbox" name="system.consumable.enabled" {{checked system.consumable.enabled}}> Enable Use action (consumes one item)</label><div class="grid"><label>AP cost in combat<input type="number" min="0" step="1" name="system.consumable.apCost" value="{{system.consumable.apCost}}"></label><label>Recover burnt Ardor<input type="number" min="0" step="1" name="system.consumable.burntArdor" value="{{system.consumable.burntArdor}}"></label><label>Heal Health<input type="number" min="0" step="1" name="system.consumable.health" value="{{system.consumable.health}}"></label><label><input type="checkbox" name="system.consumable.allBurntArdor" {{checked system.consumable.allBurntArdor}}> Recover all burnt Ardor</label><label><input type="checkbox" name="system.consumable.allHealth" {{checked system.consumable.allHealth}}> Heal all Health</label></div><p>Use restores saved resources once. Installed Ardor is unchanged.</p></fieldset>{{/if}}{{#if isGear}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Cost</legend><label>Magnetite (Mag)<input type="number" name="system.magCost" min="0" step="1" value="{{system.magCost}}"></label></fieldset>{{/if}}{{#if usesMeridians}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Equipping</legend><div class="grid"><label>Meridian cost<input name="system.meridianCost" value="{{system.meridianCost}}" type="number" min="0" step="1"></label></div></fieldset>{{/if}}{{#if isWeapon}}
<fieldset {{#unless editable}}disabled{{/unless}}><legend>Cost</legend><label>Magnetite (Mag)<input name="system.magCost" type="number" min="0" step="1" value="{{system.magCost}}"></label></fieldset>
<fieldset {{#unless editable}}disabled{{/unless}}><legend>Ammo</legend><label>Weapon ammo family<select name="system.ammoFamily">{{selectOptions ammoFamilies selected=system.ammoFamily}}</select></label><label>Selected ammo stack<select name="system.ammoId">{{selectOptions ammoSources selected=system.ammoId}}</select></label><details><summary>Legacy inline ammo</summary><div class="grid"><label>Type<input name="system.ammo.type" value="{{system.ammo.type}}"></label><label>Quantity<input type="number" min="0" step="1" name="system.ammo.quantity" value="{{system.ammo.quantity}}"></label></div></details></fieldset>
<fieldset {{#unless editable}}disabled{{/unless}}><legend>Upgrade</legend><label>Path<select name="system.upgrade">{{selectOptions upgradeChoices selected=system.upgrade}}</select></label><p data-preview="upgrade">{{weaponDetails.description}}</p><p data-preview="attack">Total attack bonus: +{{weaponDetails.attack}} · DR: {{weaponDetails.dr}}</p></fieldset>
<fieldset {{#unless editable}}disabled{{/unless}}><legend>Affinity (optional)</legend><select name="system.affinity" aria-label="Weapon affinity">{{selectOptions affinityChoices selected=system.affinity}}</select>{{#if system.affinity}}<p>Affinity uses one mod slot.</p>{{/if}}</fieldset>
<fieldset {{#unless editable}}disabled{{/unless}}><legend>Attack profile</legend><label>Weapon type<select name="system.weaponType">{{selectOptions weaponTypeChoices selected=system.weaponType}}</select></label><label>Base range (m)<input type="number" min="1" step="1" name="system.range" value="{{system.range}}"></label><label>Base damage type<select name="system.damageType">{{selectOptions damageChoices selected=system.damageType}}</select></label><p data-preview="profile">Range {{profile.range}} m; {{profile.hands}} hand(s); {{profile.actions}} action(s); {{profile.damage}}.</p><details><summary>Inherent modifiers</summary><div class="modifier-grid">{{#each inherentModifiers}}<label><input type="checkbox" name="system.properties.{{key}}" {{checked checked}}> {{label}}</label>{{/each}}</div></details></fieldset>
<section><h2>Mods</h2>{{#each modSlots}}<div class="weapon-mod-slot" data-mod-slot="{{slot}}"><span>Mod {{number}}</span>{{#if mod}}<span class="weapon-mod-name" tabindex="0">{{mod.name}}<span class="weapon-mod-tooltip" role="tooltip">{{{mod.html}}}</span></span><button type="button" data-action="removeMod" data-mod-slot="{{slot}}" {{#unless ../editable}}disabled{{/unless}}>Remove</button>{{else}}<span>Drop a Weapon Mod here</span>{{/if}}</div>{{else}}<p>Affinity occupies the available slot.</p>{{/each}}</section>
{{/if}}{{/unless}}<label>{{#if isWeaponMod}}Description{{else if isFashion}}Abilities{{else if isLicense}}Notes{{else}}Description &amp; effects{{/if}}</label>{{#if editable}}<prose-mirror name="system.description" value="{{descriptionEditor}}" data-document-uuid="{{item.uuid}}">{{{descriptionHTML}}}</prose-mirror>{{else}}<div class="rich-content">{{{descriptionHTML}}}</div>{{/if}}<section><h2>Active Effects</h2>{{#if editable}}<button type="button" data-action="createEffect">Add Effect</button>{{/if}}<ul class="inventory">{{#each effects}}<li><span>{{name}} · {{status}}<small class="effect-source">Source: {{source}}</small>{{#if changes}}<small class="effect-changes">{{changes}}</small>{{/if}}{{#if suppressed}}<small class="effect-source">Activate or equip the source item to apply this effect.</small>{{/if}}</span><button type="button" data-action="editEffect" data-effect-id="{{id}}" data-effect-item-id="{{itemId}}">Edit</button>{{#if ../editable}}<button type="button" data-action="toggleEffect" data-effect-id="{{id}}" data-effect-item-id="{{itemId}}">{{#if disabled}}Enable{{else}}Disable{{/if}}</button><button type="button" data-action="removeEffect" data-effect-id="{{id}}" data-effect-item-id="{{itemId}}">Remove</button>{{/if}}</li>{{/each}}</ul></section>{{#if hasSpecialAttacks}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Special Abilities</legend><button type="button" data-action="addSpecialAttack">Add Special Ability</button>{{#each specialAttacks}}<fieldset class="special-attack"><legend>{{name}}</legend><label>Name<input name="system.specialAttacks.{{@index}}.name" value="{{name}}" required></label><div class="grid"><label>Mode<select name="system.specialAttacks.{{@index}}.mode">{{selectOptions ../abilityModes selected=mode}}</select></label><label class="special-hostile"><input type="checkbox" name="system.specialAttacks.{{@index}}.hostile" {{checked hostile}}> Hostile action</label><label>AP cost<input type="number" step="1" min="0" name="system.specialAttacks.{{@index}}.apCost" value="{{apCost}}"></label><label>Burn Ardor<input type="number" step="1" min="0" name="system.specialAttacks.{{@index}}.burnArdor" value="{{burnArdor}}"></label><label>Install Ardor<input type="number" step="1" min="0" name="system.specialAttacks.{{@index}}.installArdor" value="{{installArdor}}"></label><label>Attack bonus<input type="number" step="1" name="system.specialAttacks.{{@index}}.bonus" value="{{bonus}}"></label><label>Attack pool<select name="system.specialAttacks.{{@index}}.attackPool">{{selectOptions ../poolChoices selected=attackPool}}</select></label><label>Defense pool<select name="system.specialAttacks.{{@index}}.defensePool">{{selectOptions ../poolChoices selected=defensePool}}</select></label><label>Damage type<select name="system.specialAttacks.{{@index}}.damageType">{{selectOptions ../damageChoices selected=damageType}}</select></label><label>Target modifier<select name="system.specialAttacks.{{@index}}.effectKey">{{selectOptions ../targetEffectChoices selected=effectKey}}</select></label><label>Modifier amount<input type="number" step="1" name="system.specialAttacks.{{@index}}.effectValue" value="{{effectValue}}"></label></div><p>Optional modifier: apply or remove on selected targets from the activation chat card. Record range, duration, and exceptions below.</p><label>Description</label><prose-mirror name="system.specialAttacks.{{@index}}.description" value="{{description}}"></prose-mirror><button type="button" data-action="removeSpecialAttack" data-index="{{@index}}">Remove Special Ability</button></fieldset>{{/each}}</fieldset>{{/if}}</section>